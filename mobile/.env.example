# ── Development ──────────────────────────────────────────────────────────────
# Your local machine IP on the same WiFi as the phone (ipconfig getifaddr en0)
EXPO_PUBLIC_API_HOST=192.168.1.x

# ── Production ────────────────────────────────────────────────────────────────
# Full URL of your deployed backend — overrides API_HOST when set.
# EXPO_PUBLIC_API_URL=https://vigilant-api.onrender.com

# ── RevenueCat (in-app subscriptions) ────────────────────────────────────────
# Get these from app.revenuecat.com → Project → API Keys
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
